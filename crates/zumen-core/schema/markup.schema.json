{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zumenjs/zumen/crates/zumen-core/schema/markup.schema.json",
  "title": "zumen のマークアップ",
  "description": "図面に添えるマークアップ（決定 0021、docs/markup.md）。座標は項目のビューの用紙上の mm、Y 軸は上向き。未知のキーは保持します。",
  "type": "object",
  "required": ["format", "version", "drawing", "items"],
  "properties": {
    "format": {
      "const": "zumen-markup"
    },
    "version": {
      "const": 1
    },
    "drawing": {
      "type": "object",
      "description": "マークアップを付けた図面",
      "required": ["sha256", "format"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "図面のバイト列の SHA-256（小文字の 16 進数）"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "description": "図面の Scene.format（sfc・jww・dxf・dwg・pdf など）"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "data": {
      "type": "object",
      "description": "利用側の情報。そのまま保持します"
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "用紙上の mm の座標 [x, y]"
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "文書内で一意の id"
        },
        "kind": {
          "enum": ["redline", "cloud", "text", "finding", "photo"]
        },
        "view": {
          "type": "string",
          "minLength": 1,
          "description": "Scene.view のビュー id。単一ビューの形式では省略"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "表示色を選ぶ利用側の分類キー"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "description": "#rrggbb または #rrggbbaa。カテゴリの色より優先"
        },
        "lineWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "用紙上の mm。省略時の線幅は 2 ピクセル"
        },
        "text": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "項目の対象となる図形の id"
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
          "description": "RFC 3339 形式の日時"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
          "description": "RFC 3339 形式の日時"
        },
        "carried": {
          "type": "object",
          "required": ["from", "state"],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "移行元の図面の SHA-256"
            },
            "state": {
              "enum": ["unchanged", "changed", "removed"]
            }
          }
        },
        "data": {
          "type": "object",
          "description": "利用側の情報。そのまま保持します"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "redline"
              }
            }
          },
          "then": {
            "required": ["points"],
            "properties": {
              "points": {
                "$ref": "#/$defs/points",
                "minItems": 2
              },
              "closed": {
                "type": "boolean"
              },
              "arrows": {
                "enum": ["none", "start", "end", "both"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cloud"
              }
            }
          },
          "then": {
            "required": ["points"],
            "properties": {
              "points": {
                "$ref": "#/$defs/points",
                "minItems": 3,
                "description": "閉じた外周"
              },
              "arcLength": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "円弧の弦の長さ（用紙上の mm、既定 10）"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": ["position", "text"],
            "properties": {
              "position": {
                "$ref": "#/$defs/point",
                "description": "最初の行の左下"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "用紙上の mm（既定 3.5）"
              },
              "angle": {
                "type": "number",
                "description": "反時計回りの度（既定 0）"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "finding"
              }
            }
          },
          "then": {
            "required": ["position", "status"],
            "properties": {
              "position": {
                "$ref": "#/$defs/point",
                "description": "指摘のピンの位置"
              },
              "status": {
                "enum": ["open", "resolved", "closed"]
              },
              "points": {
                "$ref": "#/$defs/points",
                "minItems": 3,
                "description": "閉じた範囲"
              },
              "label": {
                "type": "string",
                "description": "番号など、ピン上の短い文字"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "photo"
              }
            }
          },
          "then": {
            "required": ["position", "photo"],
            "properties": {
              "position": {
                "$ref": "#/$defs/point",
                "description": "写真の撮影位置"
              },
              "photo": {
                "type": "string",
                "description": "利用側で解決する id・URL などの参照"
              },
              "direction": {
                "type": "number",
                "description": "カメラの方向。+X 軸から反時計回りの度"
              },
              "takenAt": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
                "description": "RFC 3339 形式の日時"
              }
            }
          }
        }
      ]
    }
  }
}
