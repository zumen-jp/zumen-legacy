{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zumenjs/zumen/crates/zumen-draft/schema/drawing-spec.schema.json",
  "title": "zumen の図面仕様",
  "description": "zumen::draft の図面仕様（決定 0018）。ビュー内の座標は実寸の mm、用紙の図形は用紙上の mm。文字高・矢印・表幅・ハッチング間隔などの大きさは常に用紙上の mm。",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheets"],
  "properties": {
    "units": {
      "const": "mm"
    },
    "font": {
      "type": "string",
      "description": "既定のフォント（ＭＳ ゴシックなど）"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "lineTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineType"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sheet"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "box": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "color": {
      "description": "ACI 番号 1〜255、#rrggbb、bylayer、byblock",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}|[Bb][Yy][Ll][Aa][Yy][Ee][Rr]|[Bb][Yy][Bb][Ll][Oo][Cc][Kk])$"
        }
      ]
    },
    "align": {
      "enum": [
        "top-left",
        "top-center",
        "top-right",
        "middle-left",
        "middle-center",
        "middle-right",
        "bottom-left",
        "bottom-center",
        "bottom-right",
        "left",
        "center",
        "right",
        "middle"
      ]
    },
    "endMark": {
      "enum": ["arrow", "tick", "dot", "none"]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer": {
          "type": "string"
        },
        "textHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dimensionTextHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arrow": {
          "$ref": "#/$defs/endMark"
        },
        "arrowSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "thousands": {
          "type": "boolean"
        },
        "dimensionLayer": {
          "type": "string"
        },
        "textLayer": {
          "type": "string"
        },
        "hatchLayer": {
          "type": "string"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "plot": {
          "type": "boolean"
        },
        "off": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "lineType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pattern"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pattern": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1,
          "description": "線と空白の長さを交互に指定（用紙上の mm）。線の長さ 0 は点"
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "at"],
      "properties": {
        "tag": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/point"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "rotation": {
          "type": "number"
        },
        "invisible": {
          "type": "boolean"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "basePoint": {
          "$ref": "#/$defs/point"
        },
        "items": {
          "$ref": "#/$defs/items"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": { "pattern": "^\\s*[Mm][Oo][Dd][Ee][Ll]\\s*$" },
          "description": "空でないレイアウト名。Model は大文字小文字を問わず予約名。draft_into はテンプレートの同名レイアウトに作図"
        },
        "fields": {
          "type": "object",
          "description": "この用紙のブロック参照（表題欄）を埋めるタグ別の属性値。draft_into のテンプレートも対象",
          "additionalProperties": {
            "type": "string"
          }
        },
        "paper": {
          "oneOf": [
            {
              "enum": ["A0", "A1", "A2", "A3", "A4", "B1", "B2", "B3", "B4", "B5"]
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "orientation": {
          "enum": ["landscape", "portrait"]
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          }
        },
        "items": {
          "$ref": "#/$defs/items"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "margins": {
          "$ref": "#/$defs/box",
          "description": "左・下・右・上（mm）"
        },
        "lineWidth": {
          "type": "number"
        },
        "layer": {
          "type": "string"
        },
        "titleBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "placement": {
              "enum": ["right", "bottom-right"]
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "textHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "valueHeight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "align": {
                    "$ref": "#/$defs/align"
                  }
                }
              }
            }
          }
        }
      }
    },
    "viewTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "number": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "scaleText": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/point"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "viewport"],
      "properties": {
        "name": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "縮尺の分母（1:250 は 250）"
        },
        "viewport": {
          "$ref": "#/$defs/box",
          "description": "用紙上の範囲 [x0, y0, x1, y1]（mm）"
        },
        "center": {
          "$ref": "#/$defs/point",
          "description": "ビューポートの中央に表示するモデル座標。既定は図形の範囲の中心"
        },
        "title": {
          "$ref": "#/$defs/viewTitle"
        },
        "border": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/items"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/item.line"
        },
        {
          "$ref": "#/$defs/item.polyline"
        },
        {
          "$ref": "#/$defs/item.rectangle"
        },
        {
          "$ref": "#/$defs/item.circle"
        },
        {
          "$ref": "#/$defs/item.arc"
        },
        {
          "$ref": "#/$defs/item.ellipse"
        },
        {
          "$ref": "#/$defs/item.point"
        },
        {
          "$ref": "#/$defs/item.text"
        },
        {
          "$ref": "#/$defs/item.hatch"
        },
        {
          "$ref": "#/$defs/item.dimension"
        },
        {
          "$ref": "#/$defs/item.dimensionChain"
        },
        {
          "$ref": "#/$defs/item.insert"
        },
        {
          "$ref": "#/$defs/item.table"
        },
        {
          "$ref": "#/$defs/item.grid"
        },
        {
          "$ref": "#/$defs/item.northArrow"
        },
        {
          "$ref": "#/$defs/item.scaleBar"
        },
        {
          "$ref": "#/$defs/item.levelMark"
        },
        {
          "$ref": "#/$defs/item.spotLevel"
        },
        {
          "$ref": "#/$defs/item.leader"
        },
        {
          "$ref": "#/$defs/item.polygonLabel"
        },
        {
          "$ref": "#/$defs/item.viewTitle"
        },
        {
          "$ref": "#/$defs/item.group"
        }
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "at"],
      "properties": {
        "label": {
          "type": "string"
        },
        "at": {
          "type": "number"
        }
      }
    },
    "item.line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to"],
      "properties": {
        "type": {
          "const": "line"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "item.polyline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": {
          "const": "polyline"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "points": {
          "$ref": "#/$defs/points"
        },
        "closed": {
          "type": "boolean"
        },
        "bulges": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "item.rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to"],
      "properties": {
        "type": {
          "const": "rectangle"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        },
        "fill": {
          "type": "boolean"
        }
      }
    },
    "item.circle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "center", "radius"],
      "properties": {
        "type": {
          "const": "circle"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "type": "number"
        },
        "fill": {
          "type": "boolean"
        }
      }
    },
    "item.arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "center", "radius", "start", "end"],
      "properties": {
        "type": {
          "const": "arc"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "type": "number"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      }
    },
    "item.ellipse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "center", "majorAxis", "ratio"],
      "properties": {
        "type": {
          "const": "ellipse"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "majorAxis": {
          "$ref": "#/$defs/point"
        },
        "ratio": {
          "type": "number"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      }
    },
    "item.point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at"],
      "properties": {
        "type": {
          "const": "point"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "at": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "item.text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "text"],
      "properties": {
        "type": {
          "const": "text"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "at": {
          "$ref": "#/$defs/point"
        },
        "text": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "rotation": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "description": "この幅で折り返す（用紙上の mm）"
        },
        "fit": {
          "type": "number",
          "description": "この幅に収めるよう横倍率を縮める（用紙上の mm）"
        },
        "widthFactor": {
          "type": "number"
        },
        "lineSpacing": {
          "type": "number"
        },
        "font": {
          "type": "string"
        }
      }
    },
    "item.hatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "boundaries"],
      "properties": {
        "type": {
          "const": "hatch"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/points"
          }
        },
        "pattern": {
          "type": "string",
          "description": "SOLID（既定）、LINE・ANSI31・ANSI32・ANSI37・NET・DOTS・DASH・GROUND、または patternLines 付きの独自名"
        },
        "scale": {
          "type": "number"
        },
        "angle": {
          "type": "number"
        },
        "patternLines": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "outline": {
          "type": "boolean"
        }
      }
    },
    "item.dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["radius", "diameter"] } }, "required": ["kind"] },
          "then": { "required": ["center", "radius"] }
        },
        {
          "if": { "properties": { "kind": { "const": "angular" } }, "required": ["kind"] },
          "then": { "required": ["center", "from", "to"] }
        },
        {
          "if": {
            "anyOf": [
              { "not": { "required": ["kind"] } },
              { "properties": { "kind": { "enum": ["linear", "aligned"] } }, "required": ["kind"] }
            ]
          },
          "then": { "required": ["from", "to"] }
        }
      ],
      "properties": {
        "type": {
          "const": "dimension"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "kind": {
          "enum": ["linear", "aligned", "angular", "radius", "diameter"]
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        },
        "at": {
          "$ref": "#/$defs/point"
        },
        "angle": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "arrow": {
          "$ref": "#/$defs/endMark"
        },
        "arrowSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "textHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "thousands": {
          "type": "boolean"
        },
        "extensionGap": {
          "type": "number"
        },
        "extensionBeyond": {
          "type": "number"
        }
      }
    },
    "item.dimensionChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": {
          "const": "dimensionChain"
        },
        "layer": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "lineType": {
          "type": "string"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.11
        },
        "points": {
          "$ref": "#/$defs/points"
        },
        "angle": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "at": {
          "$ref": "#/$defs/point"
        },
        "total": {
          "type": "boolean"
        },
        "totalOffset": {
          "type": "number"
        },
        "arrow": {
          "$ref": "#/$defs/endMark"
        },
        "arrowSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "textHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "thousands": {
          "type": "boolean"
        },
        "extensionGap": {
