{
  "name": "@zumenjs/pdf",
  "version": "0.1.1",
  "description": "pdf.js で PDF 図面のページと PDF の下敷きを描く、@zumenjs/viewer 向けの描画処理",
  "keywords": [
    "cad",
    "drawing",
    "pdf",
    "pdf.js",
    "viewer",
    "aec"
  ],
  "homepage": "https://github.com/zumen-jp/zumen-legacy/tree/main/packages/pdf#readme",
  "bugs": {
    "url": "https://github.com/zumen-jp/zumen-legacy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumen-jp/zumen-legacy.git",
    "directory": "packages/pdf"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@zumenjs/core": "workspace:*",
    "@zumenjs/viewer": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": "^5.0.0 || ^6.0.0"
  }
}
