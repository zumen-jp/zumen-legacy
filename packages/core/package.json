{
  "name": "@zumenjs/core",
  "version": "0.1.1",
  "description": "Format-neutral 2D drawing scene model for zumen: the DrawingReader interface, geometry, text layout and measurement, without the DOM",
  "keywords": [
    "cad",
    "drawing",
    "scene",
    "aec"
  ],
  "homepage": "https://github.com/zumenjs/zumen/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/zumenjs/zumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumenjs/zumen.git",
    "directory": "packages/core"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "@zumenjs/source": "./src/geometry.ts",
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./text": {
      "@zumenjs/source": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./geometry": {
        "types": "./dist/geometry.d.ts",
        "default": "./dist/geometry.js"
      },
      "./text": {
        "types": "./dist/text.d.ts",
        "default": "./dist/text.js"
      },
      "./package.json": "./package.json"
    }
  }
}
