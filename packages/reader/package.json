{
  "name": "@zumenjs/reader",
  "version": "0.1.0",
  "description": "Read every zumen format (SXF, JWW, DXF, DWG) in browsers and Node.js with zumen's Rust readers built to WebAssembly, on the page or in a Web Worker",
  "keywords": [
    "cad",
    "drawing",
    "sxf",
    "jww",
    "dxf",
    "dwg",
    "autocad",
    "viewer",
    "webassembly"
  ],
  "homepage": "https://github.com/zumenjs/zumen/tree/main/packages/reader#readme",
  "bugs": {
    "url": "https://github.com/zumenjs/zumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumenjs/zumen.git",
    "directory": "packages/reader"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "files": [
    "dist",
    "src",
    "wasm/zumen_wasm.js",
    "wasm/zumen_wasm.d.ts",
    "wasm/zumen_wasm_bg.wasm",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@zumenjs/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./zumen_wasm_bg.wasm": "./wasm/zumen_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "./zumen_wasm_bg.wasm": "./wasm/zumen_wasm_bg.wasm",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@zumenjs/core": "workspace:*"
  }
}
