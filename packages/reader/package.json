{
  "name": "@zumenjs/reader",
  "version": "0.1.1",
  "description": "SXF・JWW・DXF・DWG・PDF をブラウザと Node.js で読み取る。Rust と共通の WebAssembly をページ内または Web Worker で実行",
  "keywords": [
    "cad",
    "drawing",
    "sxf",
    "jww",
    "dxf",
    "dwg",
    "pdf",
    "autocad",
    "viewer",
    "webassembly"
  ],
  "homepage": "https://github.com/zumen-jp/zumen-legacy/tree/main/packages/reader#readme",
  "bugs": {
    "url": "https://github.com/zumen-jp/zumen-legacy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumen-jp/zumen-legacy.git",
    "directory": "packages/reader"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "files": [
    "dist",
    "src",
    "wasm/zumen_wasm.js",
    "wasm/zumen_wasm.d.ts",
    "wasm/zumen_wasm_bg.wasm",
    "wasm/zumen_wasm_pdf.js",
    "wasm/zumen_wasm_pdf.d.ts",
    "wasm/zumen_wasm_pdf_bg.wasm",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@zumenjs/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./zumen_wasm_bg.wasm": "./wasm/zumen_wasm_bg.wasm",
    "./zumen_wasm_pdf_bg.wasm": "./wasm/zumen_wasm_pdf_bg.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "./zumen_wasm_bg.wasm": "./wasm/zumen_wasm_bg.wasm",
      "./zumen_wasm_pdf_bg.wasm": "./wasm/zumen_wasm_pdf_bg.wasm",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@zumenjs/core": "workspace:*"
  }
}
