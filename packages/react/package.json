{
  "name": "@zumenjs/react",
  "version": "0.1.0",
  "description": "React hooks for embedding the zumen drawing engine in your own UI: create the viewer, read its state and events, and read files",
  "keywords": [
    "react",
    "hooks",
    "cad",
    "drawing",
    "viewer"
  ],
  "homepage": "https://github.com/zumenjs/zumen/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/zumenjs/zumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumenjs/zumen.git",
    "directory": "packages/react"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@zumenjs/core": "workspace:*",
    "@zumenjs/viewer": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
