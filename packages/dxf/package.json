  "bugs": {
    "url": "https://github.com/zumen-jp/zumen-legacy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumen-jp/zumen-legacy.git",
    "directory": "packages/dxf"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
