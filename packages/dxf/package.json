{
  "name": "@zumenjs/dxf",
  "version": "0.1.1",
  "description": "DXF（R12〜2018、テキスト・バイナリ）をブラウザと Node.js で読み取る。DWG と共通の AutoCAD 図面モデルを使用",
  "keywords": [
    "dxf",
    "autocad",
    "cad",
    "drawing",
    "viewer"
  ],
