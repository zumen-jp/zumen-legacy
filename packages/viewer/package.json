{
  "name": "@zumenjs/viewer",
  "version": "0.1.0",
  "description": "The 2D drawing engine of zumen to embed in your own UI: Canvas rendering, view control, selection, measurement and tools, with no UI text or CSS",
  "keywords": [
    "cad",
    "drawing",
    "viewer",
    "canvas",
    "aec"
  ],
  "homepage": "https://github.com/zumenjs/zumen/tree/main/packages/viewer#readme",
  "bugs": {
    "url": "https://github.com/zumenjs/zumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumenjs/zumen.git",
    "directory": "packages/viewer"
  },
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@zumenjs/core": "workspace:*"
  }
}
