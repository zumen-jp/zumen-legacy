{
  "name": "@zumenjs/sxf",
  "version": "0.1.1",
  "description": "日本の電子納品で使う SXF（SFC・P21）図面をブラウザと Node.js で読み取る",
  "keywords": [
    "sxf",
    "sfc",
    "p21",
    "step",
    "cad",
    "drawing",
    "japan"
  ],
  "homepage": "https://github.com/zumenjs/zumen/tree/main/packages/sxf#readme",
  "bugs": {
    "url": "https://github.com/zumenjs/zumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumenjs/zumen.git",
    "directory": "packages/sxf"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@zumenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@zumenjs/core": "workspace:*"
  }
}
