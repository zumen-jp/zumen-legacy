{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // パッケージ同士は src を参照する（package.json の exports の @zumenjs/source）。ビルドは各パッケージの tsconfig.build.json
    "customConditions": ["@zumenjs/source"],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "tests",
    "playground",
    "scripts",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
